# App
PORT=3000
ENVIRONMENT=local  # local | development | staging | production

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kyung_db?schema=public"

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret

# Swagger basic auth
SWAGGER_USER=admin
SWAGGER_PASS=admin

# CORS (only needed in production)
CORS_ALLOWED_DOMAIN=yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# Docker Postgres
POSTGRES_USER=kyung
POSTGRES_PASSWORD=kyung_secret
POSTGRES_DB=kyung_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
