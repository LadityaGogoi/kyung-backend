# App
PORT=3000
ENVIRONMENT=local  # local | development | staging | production

# Database — MongoDB Atlas
# Encode special characters in the password (@ → %40, # → %23, etc.)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/kyung?retryWrites=true&w=majority"

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret

# Swagger basic auth
SWAGGER_USER=admin
SWAGGER_PASS=admin

# Cloudinary (required by the app)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS (only needed in production)
# CORS_ALLOWED_DOMAIN=yourdomain.com
# CORS_ORIGIN=https://yourdomain.com
