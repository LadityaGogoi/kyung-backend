# App
PORT=3000
ENVIRONMENT=local  # local | development | staging | production

# Database — local Postgres via docker-compose (match POSTGRES_USER/PASSWORD/DB and POSTGRES_PORT)
DATABASE_URL="postgresql://kyung:kyung_secret@localhost:5432/kyung_db?schema=public"

# JWT (use long random strings in production)
JWT_ACCESS_SECRET=change_me_to_a_long_random_secret
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_secret

# Swagger basic auth
SWAGGER_USER=admin
SWAGGER_PASS=admin

# Cloudinary (required by the app)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS (only needed in production)
# CORS_ALLOWED_DOMAIN=yourdomain.com
# CORS_ORIGIN=https://yourdomain.com

# Docker Postgres (use another POSTGRES_PORT / DATABASE_URL port if 5432 is busy)
POSTGRES_USER=kyung
POSTGRES_PASSWORD=kyung_secret
POSTGRES_DB=kyung_db
POSTGRES_PORT=5432

# Redis (match REDIS_PORT to docker-compose host mapping; use 6380 if 6379 is busy)
REDIS_HOST=localhost
REDIS_PORT=6379
